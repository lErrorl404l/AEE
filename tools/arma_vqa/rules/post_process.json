{
  "_meta": {
    "description": "Post-process effect rule database for arma_vqa. Edit freely; every entry carries its provenance.",
    "sources": {
      "pp": "https://community.bistudio.com/wiki/Post_Process_Effects",
      "create": "https://community.bistudio.com/wiki/ppEffectCreate",
      "adjust": "https://community.bistudio.com/wiki/ppEffectAdjust",
      "commit": "https://community.bistudio.com/wiki/ppEffectCommit",
      "enable": "https://community.bistudio.com/wiki/ppEffectEnable",
      "nvg": "https://community.bistudio.com/wiki/ppEffectForceInNVG"
    },
    "provenance_levels": {
      "wiki": "Stated on the BI wiki page for the command/effect.",
      "wiki-note": "From a user note on the wiki page (less authoritative).",
      "inferred": "Logical consequence of wiki text, not stated outright.",
      "heuristic": "Tunable QA threshold chosen by this tool, NOT from BI. Adjust to taste."
    },
    "source_conflicts": {
      "_note": "Where the current BI wiki and an older mirrored copy (arma.fandom.com/zh/wiki/Post_process_effects) disagree. Unresolved items should be checked against the live wiki.",
      "ColorInversion range": "0..1 (current) vs 0..2 (older); demoted to info",
      "FilmGrain defaults": "current [0.005,1.25,2.01,0.75,1,0] vs older [0.1,1.5,1.7,0.2,1.0,true]; the offline renderer fills omitted trailing params from the current set",
      "Base priorities": "older copy lists FilmGrain 2050, ColorCorrections 1550, DynamicBlur 450, ChromAberration 250; relative order is identical, which is all the ordering rules use",
      "RadialBlur/ChromAberration upper bounds": "current wiki implies 0.01/0.06 and 0.005; older copy gives no upper bound. The data only enforces min 0",
      "ColorCorrections radial radii": "documented -1..1 but ACE3 ships 10 and 2; demoted to info"
    }
  },
  "priority_table": {
    "_note": "Higher priority = applied later, on top of the others (wiki). Priority must be unique across ALL effects or ppEffectCreate returns -1.",
    "ColorInversion": 2500,
    "FilmGrain": 2000,
    "ColorCorrections": 1500,
    "DynamicBlur": 400,
    "WetDistortion": 300,
    "ChromAberration": 200,
    "RadialBlur": 100,
    "SSAO": 0,
    "Resolution": 0,
    "Sharpness": 0
  },
  "name_aliases": {
    "chromaticaberration": "ChromAberration",
    "chromaberration": "ChromAberration",
    "_note": "Wiki priority table says 'ChromaticAberration' but the effect title and every example use 'ChromAberration'."
