  "ordering_pairs": {
    "_note": "If effect A has a LOWER priority than effect B it is applied BEFORE B. Each entry lists the 'expected' application order (first applied -> later applied) and what goes wrong when inverted.",
    "pairs": [
      {
        "first": "ColorCorrections",
        "then": "FilmGrain",
        "prov": "inferred",
        "sev": "info",
        "id": "PP013",
        "problem": "Grain is applied before colour grading, so the grade (contrast/brightness/colorize) also scales the grain. Grain strength will not match what you tuned."
      },
      {
        "first": "ColorCorrections",
        "then": "ColorInversion",
        "prov": "inferred",
        "sev": "info",
        "id": "PP013",
        "problem": "Inversion is applied before colour grading; the grade acts on the inverted image."
      },
      {
        "first": "DynamicBlur",
        "then": "FilmGrain",
        "prov": "inferred",
        "sev": "info",
        "id": "PP013",
        "problem": "Blur is applied after grain, so the grain gets smeared and loses its sharpness."
      },
      {
        "first": "ChromAberration",
        "then": "ColorCorrections",
        "prov": "inferred",
        "sev": "info",
        "id": "PP013",
        "problem": "Chromatic aberration is applied after the grade; colour fringes bypass the grade."
      }
    ]
  },
  "thresholds": {
