// Test material: heat-colour + perlinNoise fixed-pattern noise (issue #204)
//
// Goal: give the thermal image a STATIC spatial mottle (FPN) on top of the
// painted heat colour.  FilmGrain (ppEffect) is temporal/animated; real LWIR
// sensors also show a fixed-pattern noise that does not move frame to frame.
//
// Mechanism under test: the perlinNoise procedural texture as Stage2 (detail
// map).  The engine generates #(ai,512,512,9)perlinNoise(...) at runtime and
// multiplies it over Stage1 - exactly the spatial mottle character.  If the
// engine composites it without killing the Stage1 heat colour, this becomes
// the FPN layer for every painted thermal object.
//
// Applied via fnc_debugApplyFPN.sqf (debug console: cursorTarget test).
ambient[]={1,0.10,0.20,1};
diffuse[]={1,0.10,0.20,1};
forcedDiffuse[]={0,0,0,0};
emmisive[]={0,0,0,0};
specular[]={0,0,0,0};
specularPower=1;
PixelShaderID="Normal";
VertexShaderID="Basic";
class Stage1
{
    texture="#(rgb,8,8,3)color(1,0.10,0.20,1)";
    uvSource="tex";
};
class Stage2
{
    texture="#(ai,512,512,9)perlinNoise(256,256,0.4,1)";
    uvSource="tex";
};
