// Heat-level 00 tile material (issue #204).
// TI colour in ambient/diffuse - the TI pass reads the material colour,
// not the Stage1 texture.  Band 00/7, q=0.00.
ambient[]={0.0,0.0,0.0,1};
diffuse[]={0.0,0.0,0.0,1};
forcedDiffuse[]={0.0,0.0,0.0,0};
emmisive[]={0,0,0,0};
specular[]={0,0,0,0};
specularPower=1;
PixelShaderID="Normal";
VertexShaderID="Basic";
class Stage1
{
    texture="#(rgb,8,8,3)color(0.0,0.0,0.0,1)";
    uvSource="tex";
};
