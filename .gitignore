# HEMTT build output
.hemttout/
@aee/

# Release archives
releases/
*.zip

# IDE
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Binary config artifacts
*.bin
*.bisign
*.bikey
*.sqfc

# HEMTT signing keys
.biprivatekey
*.hemttprivatekey

# Harness session state
.omo/
.opencode/

# Python bytecode
__pycache__/
*.pyc
.venv/
*.pyc

# Data Collection
pyghidra_mcp_projects/

# Docker test harness
/tests/docker/mods/
/tests/docker/run.log

# Fallback server install dir
/tests/docker/server/
/tests/docker/run.*.log
# Per-run directories written by --isolate/--parallel (logs, server.cfg, overlays)
/tests/docker/runs/

# Docker verifier run directories (tools/docker_test.sh --run-dir)
runs/

# Quarto build output
/docs/wiki/_site/
/tests/docker/configs/profiles/
sensor_report.txt
tools/validation/report.txt

# Local Arma 3 server path override for docker_test.sh (machine-specific)
tests/docker/server_root

# Retrieved third-party captures never enter the working tree. The bytes
# (pages, drawings, manuals, renders) are held in the local source cache
# named by tools/validation/source_cache.py, normally
# $HOME/.local/share/aee/source-cache/<domain>/. The repository publishes
# the extracted data, the SHA256 of each document and the register. Only
# JSON may be tracked under a sources directory; the guard is
# tools/tests/test_source_capture_policy.py.
data/*/sources/**
!data/*/sources/**/
!data/*/sources/**/*.json

# The verification worklist is generated by gen_weapon_worklist.py.
tools/weapon_worklist/

# Cargo build output (the native dev extension) and its staged artefacts
target/
tools/dev-harness/extension/dist/

# The dev Docker run directory (--run-dir .docker-run)
.docker-run/

# Raw space-weather downloads (rebuilt by tools/gen_space_weather.py --refresh)
data/space_weather/raw/

# Raw WMO normals downloads (rebuilt by tools/gen_climate_normals.py --refresh)
data/climate/raw/

# Local scratch directory
.scratch/
