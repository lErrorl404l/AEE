#!/bin/bash
# aee pre-commit hook - fast checks
# Runs repo-contained gates (hemtt, ste-lint, tests, validations).
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
FAILED=0

if command -v hemtt &>/dev/null; then
    echo "-> hemtt check -p -e"
    (cd "$ROOT" && hemtt check -p -e >/dev/null 2>&1) || FAILED=1
else
    echo "WARN hemtt not found, skipping"
fi

STE_LINT=""
if [ -f "$ROOT/tools/ste-lint.py" ]; then
    STE_LINT="$ROOT/tools/ste-lint.py"
fi
# ste-lint is a prose linter (ASD-STE100 writing rules): it gates markdown
# only.  SQF/hpp/cpp are code, checked by hemtt.
CHANGED=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(md|markdown)$' || true)
if [ -n "$CHANGED" ] && [ -n "$STE_LINT" ]; then
    echo "-> ste-lint on changed files"
    python3 "$STE_LINT" $CHANGED >/dev/null 2>&1 || FAILED=1
fi

if command -v python3 &>/dev/null && [ -f "$ROOT/tools/run_tests.py" ]; then
    # Unit suites + validation harness. Fast mode skips the harness; the
    # harness needs the optional libraries, so it is allowed to skip its
    # own optional checks but must pass the core path. Runner returns 0
    # only when every suite it runs passes.
    echo "-> unit tests"
    (cd "$ROOT" && python3 tools/run_tests.py --fast >/dev/null 2>&1) || FAILED=1
fi

# Sensor physics validation — stdlib only, always run. Verifies the NVG/
# thermal equations against published references and audits every tunable
# value against its documented wiki/ACE3 band.
if command -v python3 &>/dev/null && [ -f "$ROOT/tools/validation/validate_sensors.py" ]; then
    echo "-> sensor physics validation"
    (cd "$ROOT" && python3 tools/validation/validate_sensors.py >/dev/null 2>&1) || FAILED=1
fi

# Illuminance layer validation — azimuth/elevation conversion, lux bounds,
# shared-state contract. Stdlib only.
if command -v python3 &>/dev/null && [ -f "$ROOT/tools/validation/validate_illuminance.py" ]; then
    echo "-> illuminance layer validation"
    (cd "$ROOT" && python3 tools/validation/validate_illuminance.py >/dev/null 2>&1) || FAILED=1
fi

# DoF focus validation — optics physics (hyperfocal, blur circle, DoF band)
# + state machine behaviour (median aggregation, deadband, hold-on-empty,
# glide, transient rejection). Stdlib only.
if command -v python3 &>/dev/null && [ -f "$ROOT/tools/validation/validate_dof.py" ]; then
    echo "-> DoF focus validation"
    (cd "$ROOT" && python3 tools/validation/validate_dof.py >/dev/null 2>&1) || FAILED=1
fi

# Astronomical validation — lunar illuminance (Krisciunas & Schaefer 1991),
# NELM (Garstang/Bortle), DEF Stan 61-027 night classification. Stdlib only.
if command -v python3 &>/dev/null && [ -f "$ROOT/tools/validation/validate_astronomical.py" ]; then
    echo "-> astronomical validation"
    (cd "$ROOT" && python3 tools/validation/validate_astronomical.py >/dev/null 2>&1) || FAILED=1
fi

# CBA settings cross-reference — reads that no addon produces, and settings
# read with the wrong addon prefix, fail the commit. Stdlib only.
if command -v python3 &>/dev/null && [ -f "$ROOT/tools/validation/validate_cba_settings.py" ]; then
    echo "-> cba settings cross-reference"
    (cd "$ROOT" && python3 tools/validation/validate_cba_settings.py >/dev/null 2>&1) || FAILED=1
fi

# Oracle validation (JSP 939 VV&A) — ISO 9613-1 absorption, ICAO density,
# NWS heat index, WBGT weighting vs pythermalcomfort (skips when absent).
# Stdlib core path always runs.
if command -v python3 &>/dev/null && [ -f "$ROOT/tools/validation/validate_oracles.py" ]; then
    echo "-> oracle validation"
    (cd "$ROOT" && python3 tools/validation/validate_oracles.py >/dev/null 2>&1) || FAILED=1
fi

if [ "$FAILED" -ne 0 ]; then
    echo "X pre-commit hook failed. Fix issues or use --no-verify."
    exit 1
fi
echo "OK pre-commit checks passed"
