#!/bin/bash
# aee pre-commit hook - fast checks
# Runs repo-contained gates (hemtt, python tests). The operator's personal
# rules (ste-lint, audit) run only when present; they are not required for
# other contributors.
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
FAILED=0

if command -v hemtt &>/dev/null; then
    echo "-> hemtt check -p -e"
    (cd "$ROOT" && hemtt check -p -e >/dev/null 2>&1) || FAILED=1
else
    echo "WARN hemtt not found, skipping"
fi

RULES="$HOME/.config/opencode/rules"
CHANGED=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(sqf|hpp|cpp|md)$' || true)
if [ -n "$CHANGED" ] && [ -f "$RULES/ste-lint.py" ]; then
    echo "-> ste-lint on changed files"
    python3 "$RULES/ste-lint.py" $CHANGED >/dev/null 2>&1 || FAILED=1
fi
if [ -f "$RULES/audit.py" ]; then
    echo "-> rules audit"
    python3 "$RULES/audit.py" >/dev/null 2>&1 || FAILED=1
fi

if [ "$FAILED" -ne 0 ]; then
    echo "X pre-commit hook failed. Fix issues or use --no-verify."
    exit 1
fi
echo "OK pre-commit checks passed"
